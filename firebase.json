{
  "functions": [
    {
      "source": "functions",
      "codebase": "nexo",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log", ".env*", ".secret.local", "tests", "coverage"],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
